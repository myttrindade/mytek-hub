# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Você encontra esses valores em: Supabase → seu projeto → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Só necessária para a "Integração com IA" (MCP). Supabase → Project Settings → API → service_role (secret).
# NUNCA use o prefixo NEXT_PUBLIC_ nessa chave e nunca a publique.
SUPABASE_SERVICE_ROLE_KEY=
